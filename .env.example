# ============================================================
# AUTOBOT.AI — Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Admin
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=thay_bang_token_ngau_nhien_64_ky_tu

# Telegram Bot
# Tạo bot mới tại @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Resend Email
# Đăng ký tại: https://resend.com
RESEND_API_KEY=YOUR_RESEND_API_KEY

# MinIO Object Storage
# Cài trên VPS: bash install-minio.sh
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=autobot-uploads
MINIO_USE_SSL=false
